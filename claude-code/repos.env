# =====================================================================================
# repos.env -- EVERY external artifact source this repo uses, in one file (docs/15).
# =====================================================================================
#
# Container images, Maven / Gradle plugin repositories, the Gradle distribution, the
# JDK auto-download, Python packages and Ubuntu packages all come from the keys below.
# Nothing else in the repo names a public registry or repository.
#
# DO NOT EDIT THIS FILE FOR YOUR COMPANY. Put your JFrog URLs in an override file:
#
#     cp repos.local.env.example repos.local.env      # git-ignored, picked up automatically
#   or keep one file for ALL projects and point at it from your shell profile:
#     export REPOS_ENV=$HOME/.config/jfrog/repos.env
#
# Precedence, first definition wins:  environment variable  >  override file  >  this file.
# The override is read FIRST, so a registry set there also flows into every derived key
# below (e.g. setting GHCR_REGISTRY re-points DEEPHAVEN_IMAGE).
#
# Who reads it:
#   * every run_*.sh / e2e / demo script, through scripts/repos.sh
#   * Gradle (settings.gradle.kts and build-logic, through gradle/repos.settings.gradle.kts)
#   * podman compose and image builds, through the variables the scripts export
#     (for a bare `podman compose ...` use:  scripts/repos.sh run podman compose ...)
#
# Format: KEY=value, one per line. ${OTHER_KEY} references are expanded. Comments go on
# their own line (a '#' inside a value is part of the value). No quotes needed.
# An empty value means "use the public default" (or "off" where noted).
#
# Check what is in effect, probe every endpoint, and sync the Gradle wrapper URL:
#     scripts/repos.sh check
# =====================================================================================

# ---- container registries ------------------------------------------------------------
# Registry prefix for images on GitHub Container Registry (the Deephaven server).
#   JFrog example: mycompany.jfrog.io/ghcr-remote
GHCR_REGISTRY=ghcr.io
# Registry prefix for images on Docker Hub (Kafka, kafka-ui, MinIO, Temurin JRE).
#   JFrog example: mycompany.jfrog.io/dockerhub-remote
DOCKERHUB_REGISTRY=docker.io

# ---- container images (registry prefix above + pinned tag) --------------------------
# Official Docker Hub images keep their library/ path, which JFrog remotes expect too.
DEEPHAVEN_IMAGE=${GHCR_REGISTRY}/deephaven/server:42.4
KAFKA_IMAGE=${DOCKERHUB_REGISTRY}/apache/kafka:3.9.1
KAFKA_UI_IMAGE=${DOCKERHUB_REGISTRY}/kafbat/kafka-ui:v1.5.0
MINIO_IMAGE=${DOCKERHUB_REGISTRY}/minio/minio:RELEASE.2025-04-22T22-12-26Z
# Base image of the dh-connectors application images (built by :dockerBuildLocal).
JRE_BASE_IMAGE=${DOCKERHUB_REGISTRY}/library/eclipse-temurin:21-jre-jammy

# ---- Python packages (pip, on the host and inside image builds) ----------------------
#   JFrog example: https://mycompany.jfrog.io/artifactory/api/pypi/pypi-remote/simple
PIP_INDEX_URL=https://pypi.org/simple
# Only for a mirror whose TLS certificate pip cannot verify; empty = off.
PIP_TRUSTED_HOST=

# ---- Maven / Gradle -------------------------------------------------------------------
# Maven repository for every Java dependency. Empty = Maven Central.
#   JFrog example: https://mycompany.jfrog.io/artifactory/maven-remote
MAVEN_REPO_URL=
# Repository for Gradle plugins (foojay, kotlin-dsl, ...). Empty = Gradle Plugin Portal.
#   JFrog example: https://mycompany.jfrog.io/artifactory/gradle-plugins-remote
GRADLE_PLUGIN_REPO_URL=
# Credentials for both repositories, if your JFrog needs them. Keep them OUT of this
# file: put them in your override file, in the environment, or in
# ~/.gradle/gradle.properties (same key names).
#   MAVEN_REPO_USERNAME=
#   MAVEN_REPO_PASSWORD=
# The Gradle distribution the wrapper downloads (synced into
# gradle/wrapper/gradle-wrapper.properties by `scripts/repos.sh check` / `run`).
#   JFrog example: https://mycompany.jfrog.io/artifactory/gradle-dist-remote/gradle-9.2.1-bin.zip
GRADLE_DISTRIBUTION_URL=https://services.gradle.org/distributions/gradle-9.2.1-bin.zip
# Let Gradle download a JDK 21 from api.foojay.io when none is installed locally.
# Corporate networks usually block it: set false and install JDK 21 yourself.
GRADLE_JDK_AUTO_DOWNLOAD=true

# ---- OS packages inside image builds ---------------------------------------------------
# Ubuntu mirrors for apt-get in dh-connectors/docker/spring-boot.Dockerfile. Two keys because
# amd64 and arm64 packages live in different Ubuntu archives:
#   APT_MIRROR        replaces archive/security.ubuntu.com/ubuntu   (amd64 images)
#     JFrog example: https://mycompany.jfrog.io/artifactory/ubuntu-remote
#   APT_PORTS_MIRROR  replaces ports.ubuntu.com/ubuntu-ports        (arm64, e.g. Apple silicon)
#     JFrog example: https://mycompany.jfrog.io/artifactory/ubuntu-ports-remote
# Empty = Ubuntu's own archives.
APT_MIRROR=
APT_PORTS_MIRROR=
