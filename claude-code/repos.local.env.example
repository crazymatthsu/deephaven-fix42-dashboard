# =====================================================================================
# repos.local.env.example -- template for YOUR company's artifact sources (docs/15).
# =====================================================================================
#
# Two ways to use it:
#
#   1. this repo only:   cp repos.local.env.example repos.local.env     (git-ignored)
#   2. every project:    keep one copy anywhere and point at it from ~/.zshrc / ~/.bashrc
#                          mkdir -p ~/.config/jfrog && cp repos.local.env.example ~/.config/jfrog/repos.env
#                          export REPOS_ENV=$HOME/.config/jfrog/repos.env
#                        Any project that follows the repos.env convention picks it up.
#
# Then check it:   scripts/repos.sh check     (shows the effective values, probes each URL,
#                                             syncs the Gradle wrapper)
#                  scripts/repos.sh pull      (pulls every image through your registry)
#
# Only list what differs from repos.env; everything you leave out keeps its public default.
# This file is read BEFORE repos.env, so the registries you set here also re-point every
# image in repos.env (DEEPHAVEN_IMAGE, KAFKA_IMAGE, ...). ${KEY} references work.
#
# The repository names below (ghcr-remote, dockerhub-remote, ...) are examples: use the
# names of the remote repositories your JFrog admins created. A remote repository proxies
# one upstream; the upstream each key must point at is noted next to it.
# =====================================================================================

# Your JFrog base URL, reused below.
JFROG_URL=https://mycompany.jfrog.io/artifactory
JFROG_DOCKER=mycompany.jfrog.io

# ---- container registries (log in once: podman login mycompany.jfrog.io) -------------
# Docker remote repository -> https://ghcr.io
GHCR_REGISTRY=${JFROG_DOCKER}/ghcr-remote
# Docker remote repository -> https://registry-1.docker.io (Docker Hub)
DOCKERHUB_REGISTRY=${JFROG_DOCKER}/dockerhub-remote
# Some JFrog setups expose each Docker repository as its own host instead of a path, e.g.
#   GHCR_REGISTRY=ghcr-remote.mycompany.jfrog.io
# Individual images can also be pinned outright (this wins over the registry prefix):
#   DEEPHAVEN_IMAGE=${JFROG_DOCKER}/approved-images/deephaven/server:42.4

# ---- Python (pip) -------------------------------------------------------------------
# PyPI remote repository -> https://pypi.org
PIP_INDEX_URL=${JFROG_URL}/api/pypi/pypi-remote/simple
# Only if pip cannot verify your JFrog TLS certificate:
#   PIP_TRUSTED_HOST=mycompany.jfrog.io

# ---- Maven / Gradle -------------------------------------------------------------------
# Maven remote repository -> https://repo.maven.apache.org/maven2 (Maven Central)
MAVEN_REPO_URL=${JFROG_URL}/maven-remote
# Gradle remote repository -> https://plugins.gradle.org/m2 (Gradle Plugin Portal)
GRADLE_PLUGIN_REPO_URL=${JFROG_URL}/gradle-plugins-remote
# Generic remote repository -> https://services.gradle.org/distributions
GRADLE_DISTRIBUTION_URL=${JFROG_URL}/gradle-dist-remote/gradle-9.2.1-bin.zip
# api.foojay.io is almost always blocked: install a JDK 21 yourself instead.
GRADLE_JDK_AUTO_DOWNLOAD=false
# If the Maven / Gradle repositories need a login. Prefer ~/.gradle/gradle.properties
# (same key names) or the environment, so the token never sits in a project folder:
#   MAVEN_REPO_USERNAME=first.last@mycompany.com
#   MAVEN_REPO_PASSWORD=<JFrog identity token>

# ---- Ubuntu packages inside image builds (dh-connectors images only) ----------------
# Debian remote repository -> http://archive.ubuntu.com/ubuntu          (amd64)
APT_MIRROR=${JFROG_URL}/ubuntu-remote
# Debian remote repository -> http://ports.ubuntu.com/ubuntu-ports      (arm64, Apple silicon)
APT_PORTS_MIRROR=${JFROG_URL}/ubuntu-ports-remote
